{"openapi":"3.0.1","info":{"title":"URL Shortener API","description":"Production-grade URL shortener: create, redirect, and analytics endpoints","version":"v1"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Redirect","description":"Public short-link redirection"},{"name":"Analytics","description":"Click analytics for short links"},{"name":"Links","description":"Create, inspect, update, and deactivate short links"}],"paths":{"/urls":{"post":{"tags":["Links"],"summary":"Create a short link","description":"Validates the target URL, assigns a short code (or uses the supplied alias), and persists it. `ttlSeconds` is optional. Free-tier callers (no `X-Api-Key`, or an unrecognized/inactive one) get a mandatory 30-day cap and default; premium callers may omit it for a link that never expires, or set an explicit value up to a much larger ceiling.","operationId":"createLink","parameters":[{"name":"X-Api-Key","in":"header","description":"Optional API key; resolves the caller's plan tier (defaults to free if omitted/unrecognized)","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateLinkRequest"}}},"required":true},"responses":{"409":{"description":"Alias already in use","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"201":{"description":"Link created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LinkResponse"}}}},"400":{"description":"Invalid URL/request body, or ttlSeconds exceeds the free-tier limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/urls/{shortCode}":{"get":{"tags":["Links"],"summary":"Get link metadata","description":"Returns link metadata (not analytics - see GET /analytics/{shortCode}).","operationId":"getLink","parameters":[{"name":"shortCode","in":"path","description":"Short code identifying the link","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"No link for this short code","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Link found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LinkResponse"}}}}}},"delete":{"tags":["Links"],"summary":"Deactivate a link","description":"Idempotent: marks the link DEACTIVATED so future redirects return 410 Gone.","operationId":"deactivateLink","parameters":[{"name":"shortCode","in":"path","description":"Short code identifying the link","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Link deactivated"},"404":{"description":"No link for this short code","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"patch":{"tags":["Links"],"summary":"Partially update a link","description":"Reactivates/deactivates via `active`, and/or replaces the expiry via `ttlSeconds` (subject to the same tier-dependent cap as create - see `X-Api-Key`). Omitted fields are left unchanged.","operationId":"updateLink","parameters":[{"name":"shortCode","in":"path","description":"Short code identifying the link","required":true,"schema":{"type":"string"}},{"name":"X-Api-Key","in":"header","description":"Optional API key; resolves the caller's plan tier (defaults to free if omitted/unrecognized)","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateLinkRequest"}}},"required":true},"responses":{"404":{"description":"No link for this short code","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"400":{"description":"Invalid request body, or ttlSeconds exceeds the free-tier limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Link updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LinkResponse"}}}}}}},"/{shortCode}":{"get":{"tags":["Redirect"],"summary":"Redirect to the original URL","description":"Resolves a short code and responds with a 302 redirect. Records the click asynchronously.","operationId":"redirect","parameters":[{"name":"shortCode","in":"path","description":"Short code identifying the link","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"No link for this short code","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"410":{"description":"Link is expired or deactivated","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"302":{"description":"Redirect to the original URL"}}}},"/analytics/{shortCode}":{"get":{"tags":["Analytics"],"summary":"Get click analytics","description":"Returns total click count and first/last access times for a short code.","operationId":"getAnalytics","parameters":[{"name":"shortCode","in":"path","description":"Short code identifying the link","required":true,"schema":{"type":"string"}}],"responses":{"404":{"description":"No link for this short code","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Analytics found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalyticsResponse"}}}}}}}},"components":{"schemas":{"CreateLinkRequest":{"required":["longUrl"],"type":"object","properties":{"longUrl":{"maxLength":2048,"minLength":0,"type":"string"},"alias":{"pattern":"^[A-Za-z0-9_-]{3,32}$","type":"string"},"ttlSeconds":{"maximum":315360000,"type":"integer","format":"int64"}}},"ErrorResponse":{"type":"object","properties":{"timestamp":{"type":"string","format":"date-time"},"status":{"type":"integer","format":"int32"},"error":{"type":"string"},"message":{"type":"string"},"details":{"type":"array","items":{"type":"string"}},"correlationId":{"type":"string"}}},"LinkResponse":{"type":"object","properties":{"shortCode":{"type":"string"},"shortUrl":{"type":"string"},"originalUrl":{"type":"string"},"status":{"type":"string"},"createdAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"}}},"UpdateLinkRequest":{"type":"object","properties":{"ttlSeconds":{"maximum":315360000,"type":"integer","format":"int64"},"active":{"type":"boolean"}}},"AnalyticsResponse":{"type":"object","properties":{"shortCode":{"type":"string"},"totalClicks":{"type":"integer","format":"int64"},"firstAccessedAt":{"type":"string","format":"date-time"},"lastAccessedAt":{"type":"string","format":"date-time"}}}}}}